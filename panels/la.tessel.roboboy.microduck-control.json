{
  "schemaVersion": 1,
  "id": "la.tessel.roboboy.microduck-control",
  "name": "Microduck Control",
  "description": "Drive Microduck, select learned motion modes, move its mouth, and trigger a simulated jump.",
  "repository": "https://github.com/tessel-la/robo-boy-microduck-control-panel",
  "author": {
    "name": "tessel·la"
  },
  "latest": {
    "version": "1.1.0",
    "compatibility": {
      "panelApi": "^2.0.0",
      "roboboy": ">=0.3.0-0 <1.0.0"
    },
    "capabilities": [
      "ros"
    ],
    "permissions": {
      "ros": {
        "subscribe": [
          "/locomotion/status"
        ],
        "publish": [
          "/cmd_vel",
          "/locomotion/policy_cmd"
        ],
        "services": [
          "/locomotion/mouth",
          "/locomotion/jump"
        ]
      }
    },
    "distribution": {
      "type": "javascript-bundle",
      "manifestUrl": "https://github.com/tessel-la/robo-boy-microduck-control-panel/releases/download/v1.1.0/roboboy.panel.json",
      "bundleUrl": "https://github.com/tessel-la/robo-boy-microduck-control-panel/releases/download/v1.1.0/index.js",
      "entryPoint": "index.js",
      "integrity": "sha256-G2/eRWDnQTbxC7bdirbm2NnVm/hIdxv0CKK2Ev5PJ3U="
    }
  },
  "tags": [
    "ros",
    "microduck",
    "locomotion",
    "reinforcement-learning",
    "simulation"
  ]
}

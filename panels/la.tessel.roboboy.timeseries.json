{
  "schemaVersion": 1,
  "id": "la.tessel.roboboy.timeseries",
  "name": "ROS Time Series",
  "description": "Plots configurable numeric fields from a ROS topic with pause, scaling, retention, and CSV controls.",
  "repository": "https://github.com/tessel-la/roboboy-timeseries-panel",
  "author": {
    "name": "Tessella"
  },
  "latest": {
    "version": "2.0.0",
    "compatibility": {
      "panelApi": "^2.0.0",
      "roboboy": ">=0.3.0-0 <1.0.0"
    },
    "capabilities": ["ros", "storage"],
    "permissions": {
      "ros": {
        "selectTopic": true
      }
    },
    "distribution": {
      "type": "javascript-bundle",
      "manifestUrl": "https://github.com/tessel-la/roboboy-timeseries-panel/releases/download/v2.0.0/roboboy.panel.json",
      "bundleUrl": "https://github.com/tessel-la/roboboy-timeseries-panel/releases/download/v2.0.0/index.js",
      "entryPoint": "index.js",
      "integrity": "sha256-iAiRQl0ng2Tk2ikcQeOHSFHWFDaL/ui2gUEyT83LYL0="
    }
  },
  "tags": ["ros", "telemetry", "plot", "timeseries"]
}
